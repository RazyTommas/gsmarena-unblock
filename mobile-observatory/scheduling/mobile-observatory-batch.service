[Unit]
Description=Mobile Observatory ingest batch (advisory alarm on source silence -- see docs/SCHEDULING.md)
# Paired with mobile-observatory-batch.timer. Neither is installed or
# enabled by this repository; a human copies and edits both, then runs the
# systemctl commands in docs/SCHEDULING.md deliberately.

[Service]
Type=oneshot
# CHANGE ME: absolute path to this checkout's mobile-observatory/ directory.
WorkingDirectory=/CHANGE/ME/mobile-observatory
ExecStart=/CHANGE/ME/mobile-observatory/scheduling/run-batch.sh
# Measured at 2m08s against the development corpus. This is sized for the
# production volume instead, which is roughly 200x that and runs for hours:
# at 30m systemd would SIGTERM the batch mid-run every single night, and the
# symptom would be a nightly failed unit rather than anything naming a clock.
# Raise it further if your corpus is larger; it is a ceiling, not a target,
# and a batch that finishes early is not penalised for it.
TimeoutStartSec=12h

# batch.py's exit codes: 0 = ran, nothing overdue. 2 = ran fine, but at
# least one source is silent (advisory -- see docs/SOURCE_SILENCE_DETECTION.md).
# 3 = refused to start because another batch still holds the corpus lock;
# harmless on its own, but a run of them means the batch no longer finishes
# inside its period. Any other nonzero = the batch itself failed. systemd
# treats all of these as a failed unit, which is what makes `systemctl --user
# status`/`journalctl --user -u mobile-observatory-batch.service` show it,
# and what a monitoring check against this unit's ActiveState would catch.
#
# Uncomment to also fire a notification unit you define yourself on EITHER
# kind of failure (systemd does not distinguish exit code 2 from any other
# nonzero code here without a small wrapper; see docs/SCHEDULING.md):
# OnFailure=mobile-observatory-batch-alert.service
